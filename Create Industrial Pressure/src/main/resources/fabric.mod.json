  "authors": [
    "Shiro1337"
  ],
  "contact": {},
  "license": "LicenseRef-All-Rights-Reserved",
  "icon": "assets/createhp/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.shiro.createhp.CreateHP"
    ],
    "client": [
      "net.shiro.createhp.client.CHPClient"
    ]
  },
  "mixins": [
    "createhp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": ">=6.0.0",
    "minecraft": "${minecraft_version}"
