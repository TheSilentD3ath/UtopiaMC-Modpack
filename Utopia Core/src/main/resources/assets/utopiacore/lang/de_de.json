  "trait.utopia.class.engineer": "Ingenieur",
  "trait.utopia.class.engineer.desc": "Zahnräder, Wellen, Vorrichtungen. Startet mit den Create-Grundlagen und zahlt weniger für diesen Baum.",
  "trait.utopia.class.farmer": "Bauer",
  "trait.utopia.class.farmer.desc": "Alle werden satt, weil du pflanzt. Saatgut, Hacke, Wasser, Geduld.",
  "trait.utopia.class.hunter": "Jäger",
  "trait.utopia.class.hunter.desc": "Geduldig und schnell. Du erlegst, worauf du zielst, aus einer Entfernung deiner Wahl.",
  "trait.utopia.class.miner": "Bergmann",
  "trait.utopia.class.miner.desc": "Die Tiefe ist dein Zuhause. Fackeln, eine gute Spitzhacke und nichts zwischen dir und dem Grundgestein.",
  "trait.utopia.class.smith": "Schmied",
  "trait.utopia.class.smith.desc": "Eisen beugt sich dir. Bring das Erz mit und geh mit etwas, das sich zu tragen lohnt.",
  "trait.utopia.class.survivor": "Überlebenskünstler",
  "trait.utopia.class.survivor.desc": "Kein Spezialgebiet, keine Schwäche. Zusätzliche Punkte, um zu werden, was die Welt braucht.",
  "trait.utopia.class.tank": "Tank",
  "trait.utopia.class.tank.desc": "Die Mauer. Schild hoch, Kesselhelm auf, und alles hinter dir bleibt am Leben.",
  "trait.utopia.class.trader": "Händler",
  "trait.utopia.class.trader.desc": "Smaragde in der Tasche und einen Riecher für gute Geschäfte.",
  "trait.utopia.class.warrior": "Krieger",
  "trait.utopia.class.warrior.desc": "Vorderste Front. Schwere Klinge, Kettenrüstung und genug Selbstvertrauen, um zuerst in den Kampf zu gehen.",
  "trait.utopia.class.wizard": "Zauberer",
  "trait.utopia.class.wizard.desc": "Roben, Fläschchen und ein Händchen dafür, dass sich die Welt seltsam verhält.",
  "trait.utopia.gender.female": "Weiblich",
